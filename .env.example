# ---- required -------------------------------------------------------------
# Public domain for this deployment. Use "localhost" for local development
# Production: point a *.<DOMAIN> wildcard to the server's IP.
DOMAIN=localhost

# Basic-auth for wallet + admin RPC.
# Default password: "canopy". CHANGE IT for production:
#   make hash-password
# (prompts for a password and prints an already-escaped hash, ready to paste below)
#
# If generating manually instead, escape every $ as $$:
#   docker run --rm -it caddy:2.11-alpine caddy hash-password
AUTH_USER=canopy
AUTH_PASSWORDHASH=$$2a$$14$$0IP2/ZvbwWQ0JsJp6B8IpOYxME/6KSuPY3l4Hpj8phNTMdjMdh8aa

# Grafana credentials
GF_ADMIN_USER=canopy
GF_ADMIN_PASSWORD=canopy

# (Optional) Mainnet snapshot for `make snapshot`
SNAPSHOT_URL=http://canopy-mainnet-latest-chain-id1.us.nodefleet.net

# (Optional) External alert routing notifications
ALERTS_DISCORD_WEBHOOK=
ALERTS_PAGERDUTY_ROUTING_KEY=
