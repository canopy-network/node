# ---- required -------------------------------------------------------------
# Public domain for this deployment. Use "localhost" for local development
# Production: point a *.<DOMAIN> wildcard (or the wallet/explorer/rpc/adminrpc
# host records) at this box.
DOMAIN=localhost
# Let's Encrypt registration email (unused for localhost).
ACME_EMAIL=admin@example.com
# Basic-auth guarding the wallet + admin RPC.
# Default password: "canopy" — CHANGE IT for production: run
#   make hash-password
AUTH_USER=canopy
AUTH_PASSWORDHASH=$$2a$$14$$0IP2/ZvbwWQ0JsJp6B8IpOYxME/6KSuPY3l4Hpj8phNTMdjMdh8aa
# ---- optional --------------------------------------------------------------
# Mainnet snapshot for `make snapshot`
SNAPSHOT_URL=http://canopy-mainnet-latest-chain-id1.us.nodefleet.net
# Grafana admin (only used with: docker compose --profile monitoring up -d)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
